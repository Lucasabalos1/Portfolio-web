---
import Layout from "../../layouts/Layout.astro"
import { getCollection, render } from "astro:content"

export async function getStaticPaths() {
    const projects = await getCollection('project')
    
    return projects.map((project) => ({
        params: {id: project.id},
        props: {project}
    }));
}

const {project} = Astro.props
const slug = project.id
const {title, description, tags, image, link, code, docs, gallery} = project.data
const {Content} = await render(project) 

 
---

<Layout>
    <section class="min-h-screen md:h-screen md:overflow-hidden flex flex-col">
        <div class="flex flex-1 flex-col md:flex-row  gap-4 m-4 bg-blue-900/20 rounded-3xl p-6 border border-yellow-700/20 overflow-hidden relative">
            <a href="/#proyectos" class="absolute top-4 left-4 z-10 rounded-xl bg-white/5 border border-white/10 text-white/70 hover:bg-white/10 hover:text-white transition-all backdrop-blur-md px-3 py-1">Volver atras</a>

            <div class="w-full md:w-1/2 flex flex-col justify-between h-full">
                <h2 class="text-center font-bold text-4xl mb-4 mt-6 md:mt-0">{title}</h2>
                
                <div class="grid grid-cols-2 gap-2">
                    {gallery && gallery.length > 0 ? gallery.slice(0, 4).map((img, index) => (
                        <img src={img} transition:name={index === 0 ? `img-${slug}` : undefined} class="w-full h-auto object-contain rounded-xl" alt={`Imagen-${index + 1}-Proyecto`}>
                    )) : (
                        <img src={image} transition:name={`img-${slug}`} class="w-full h-auto object-contain rounded-xl col-span-2" alt="Imagen-Proyecto">
                    )}
                </div>

                <div class="grid grid-cols-2 gap-3 mt-6 w-full max-w-md mx-auto">
                    {link && link.trim() !== "" ? ( <a href={link} target="_blank" rel="noopener noreferrer" class="col-span-2 py-2 text-center font-bold bg-blue-600 hover:bg-blue-500 rounded-xl transition-all">Demo</a>) : (<span class="col-span-2 flex items-center text-white/40">Demo no disponible</span>) }
                    {code && code.trim() !== "" ? ( <a href={code} target="_blank" rel="noopener noreferrer" class={`py-2 text-center font-bold bg-[#24292e] hover:bg-[#2f363d] border border-white/10 rounded-xl transition-all ${docs ? "" : "col-span-2"}`}>Código</a>) : (<span class={`flex items-center text-white/40 ${docs ? "" : "col-span-2"}`}>Código no disponible</span>) }
                    {docs && docs.trim() !== "" && ( <a href={docs} target="_blank" rel="noopener noreferrer" class="py-2 text-center font-bold bg-white/10 hover:bg-white/20 border border-white/20 text-white/90 rounded-xl transition-all">Documentación</a> ) }
                </div>
            </div>

            <div class="w-full md:w-1/2 h-[65vh] md:h-full overflow-y-auto md:pr-8 custom-scrollbar">
                <article class="prose prose-invert max-w-none">
                    <Content />
                </article>
            </div>
        </div>
    </section>
</Layout>

<style>
    .custom-scrollbar::-webkit-scrollbar {
        width: 8px;
        background: #121212;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #00217a;
        border-radius: 4px;
    }
</style>