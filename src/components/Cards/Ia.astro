---
import SkillChip from "./SkillChip.astro";

const glowHover = "hover:shadow-[0_0_12px_rgba(59,130,246,0.2)]";

const skills = [
    { name: "Machine Learning", logo: "/Images/Logos/machine_learning.webp", accent: `border-white/10 bg-white/5 hover:border-purple-500/50 hover:text-purple-400 ${glowHover}` },
    { name: "Redes Neuronales Recurrentes", logo: "/Images/Logos/rnn.webp", compact: true, accent: `border-white/10 bg-white/5 hover:border-purple-600/50 hover:text-purple-500 ${glowHover}` },
    { name: "LLMs", logo: "/Images/Logos/llm.webp", accent: `border-white/10 bg-white/5 hover:border-purple-500/50 hover:text-purple-400 ${glowHover}` },
    { name: "OpenCode", logo: "/Images/Logos/Opencode.webp", accent: `border-white/10 bg-white/5 hover:border-purple-500/50 hover:text-purple-400 ${glowHover}` },
    { name: "Claude Code", logo: "/Images/Logos/claudecode.webp", accent: `border-white/10 bg-white/5 hover:border-orange-500/50 hover:text-orange-400 ${glowHover}` },
    { name: "n8n", logo: "/Images/Logos/n8n-icon.webp", accent: `border-white/10 bg-white/5 hover:border-purple-500/50 hover:text-purple-400 ${glowHover}` },
];
---

<article class="bg-blue-950/20 backdrop-blur-sm border border-blue-500/30 rounded-2xl p-6">
    <h3 class="block text-center text-3xl font-bold mb-2">Inteligencia Artificial</h3>
    <hr class="w-3/4 mx-auto border-blue-500/50 mb-2">
    <ul class="w-full grid grid-cols-2 lg:grid-cols-3 gap-3">
        {skills.map((skill) => <SkillChip {...skill} />)}
    </ul>
</article>