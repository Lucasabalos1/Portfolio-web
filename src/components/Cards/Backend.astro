---
import SkillChip from "./SkillChip.astro";

const glowHover = "hover:shadow-[0_0_12px_rgba(59,130,246,0.2)]";

const skills = [
    { name: "Python", logo: "/Images/Logos/python_logo.webp", accent: `border-white/10 bg-white/5 hover:border-blue-500/50 hover:text-blue-400 ${glowHover}` },
    { name: "Flask", logo: "/Images/Logos/flask_logo.webp", accent: `border-white/10 bg-white/5 hover:border-white/50 hover:text-white ${glowHover}` },
    { name: "Java", logo: "/Images/Logos/java_logo.webp", accent: `border-white/10 bg-white/5 hover:border-orange-500/50 hover:text-orange-400 ${glowHover}` },
    { name: "PostgreSQL", logo: "/Images/Logos/Postgres.webp", accent: `border-white/10 bg-white/5 hover:border-blue-500/50 hover:text-blue-400 ${glowHover}` },
    { name: "SQLite", logo: "/Images/Logos/Sqlite.webp", accent: `border-white/10 bg-white/5 hover:border-blue-500/50 hover:text-blue-400 ${glowHover}` },
    { name: "C#", logo: "/Images/Logos/Csharp_Logo.webp", accent: `border-white/10 bg-white/5 hover:border-purple-500/50 hover:text-purple-400 ${glowHover}` },
    { name: ".NET", logo: "/Images/Logos/Microsoft_.NET_logo.svg.webp", accent: `border-white/10 bg-white/5 hover:border-blue-500/50 hover:text-blue-400 ${glowHover}` },
    { name: "Docker", logo: "/Images/Logos/Docker.webp", accent: `border-white/10 bg-white/5 hover:border-blue-500/50 hover:text-blue-400 ${glowHover}` },
    { name: "MongoDB", logo: "/Images/Logos/mongodb.webp", accent: `border-white/10 bg-white/5 hover:border-green-500/50 hover:text-green-400 ${glowHover}` },
    { name: "API REST", logo: "/Images/Logos/rest-api.webp", accent: `border-white/10 bg-white/5 hover:border-blue-500/50 hover:text-blue-400 ${glowHover}` },
];
---

<article class="bg-blue-950/20 backdrop-blur-sm border border-blue-500/30 rounded-2xl p-6">
    <h3 class="block text-center text-3xl font-bold mb-2">Backend & Databases</h3>
    <hr class="w-3/4 mx-auto border-blue-500/50 mb-2">
    <ul class="w-full grid grid-cols-2 lg:grid-cols-3 gap-3">
        {skills.map((skill) => <SkillChip {...skill} />)}
    </ul>
</article>