---
import SkillChip from "./SkillChip.astro";

const glowHover = "hover:shadow-[0_0_12px_rgba(59,130,246,0.2)]";

const skills = [
    { name: "React", logo: "/Images/Logos/React-icon.svg.webp", accent: `border-white/10 bg-white/5 hover:border-blue-500/50 hover:text-blue-400 ${glowHover}` },
    { name: "Typescript", logo: "/Images/Logos/Typescript.webp", accent: `border-white/10 bg-white/5 hover:border-blue-600/50 hover:text-blue-500 ${glowHover}` },
    { name: "Tailwind CSS", logo: "/Images/Logos/Tailwind.webp", accent: `border-white/10 bg-white/5 hover:border-blue-500/50 hover:text-blue-400 ${glowHover}` },
    { name: "Astro", logo: "/Images/Logos/astro-icon-dark.webp", accent: `border-white/10 bg-white/5 hover:border-orange-500/50 hover:text-orange-400 ${glowHover}` },
    { name: "HTML", logo: "/Images/Logos/HTML5_logo.webp", accent: `border-white/10 bg-white/5 hover:border-orange-500/50 hover:text-orange-400 ${glowHover}` },
    { name: "CSS", logo: "/Images/Logos/CSS_logo.webp", accent: `border-white/10 bg-white/5 hover:border-blue-500/50 hover:text-blue-400 ${glowHover}` },
    { name: "Javascript", logo: "/Images/Logos/JavaScript-Symbol.webp", imgClass: "w-8 h-8 md:w-9 md:h-9", accent: `border-white/10 bg-white/5 hover:border-yellow-500/50 hover:text-yellow-400 ${glowHover}` },
    { name: "Figma", logo: "/Images/Logos/Figma.webp", accent: `border-white/10 bg-white/5 hover:border-gray-500/50 hover:text-gray-400 ${glowHover}` },
    { name: "Excalidraw", logo: "/Images/Logos/Excalidraw.webp", accent: `border-white/10 bg-white/5 hover:border-purple-500/50 hover:text-purple-400 ${glowHover}` },
    { name: "Vite", logo: "/Images/Logos/Vitejs-logo.svg.webp", accent: `border-white/10 bg-white/5 hover:border-purple-500/50 hover:text-purple-400 ${glowHover}` },
];
---

<article class="bg-blue-950/20 backdrop-blur-sm border border-blue-500/30 rounded-2xl p-6">
    <h3 class="block text-center text-3xl font-bold mb-2">Frontend & Diseño</h3>
    <hr class="w-3/4 mx-auto border-blue-500/50 mb-2">
    <ul class="w-full grid grid-cols-2 lg:grid-cols-3 gap-3">
        {skills.map((skill) => <SkillChip {...skill} />)}
    </ul>
</article>