---
import SkillChip from "./SkillChip.astro";

const glowHover = "hover:shadow-[0_0_12px_rgba(59,130,246,0.2)]";

const skills = [
    { name: "Scrum", logo: "/Images/Logos/scrum.webp", accent: `border-white/10 bg-white/5 hover:border-blue-500/50 hover:text-blue-400 ${glowHover}` },
    { name: "Jira", logo: "/Images/Logos/jira.webp", accent: `border-white/10 bg-white/5 hover:border-blue-600/50 hover:text-blue-500 ${glowHover}` },
    { name: "Git", logo: "/Images/Logos/git.webp", accent: `border-white/10 bg-white/5 hover:border-orange-500/50 hover:text-orange-400 ${glowHover}` },
    { name: "Github", logo: "/Images/Logos/github.webp", accent: `border-white/10 bg-white/5 hover:border-gray-500/50 hover:text-gray-400 ${glowHover}` },
    { name: "Postman", logo: "/Images/Logos/postman.webp", accent: `border-white/10 bg-white/5 hover:border-orange-500/50 hover:text-orange-400 ${glowHover}` },
    { name: "Draw.io", logo: "/Images/Logos/drawio.webp", accent: `border-white/10 bg-white/5 hover:border-yellow-500/50 hover:text-yellow-400 ${glowHover}` },
    { name: "Pytest", logo: "/Images/Logos/pytest.webp", accent: `border-white/10 bg-white/5 hover:border-gray-500/50 hover:text-gray-400 ${glowHover}` },
    { name: "XUnit", logo: "/Images/Logos/Xunit.webp", accent: `border-white/10 bg-white/5 hover:border-gray-500/50 hover:text-gray-400 ${glowHover}` },
    { name: "Sistemas ERP", logo: "/Images/Logos/ERP.webp", accent: `border-white/10 bg-white/5 hover:border-green-500/50 hover:text-green-400 ${glowHover}` },
];
---

<article class="bg-blue-950/20 backdrop-blur-sm border border-blue-500/30 rounded-2xl p-6">
    <h3 class="block text-center text-3xl font-bold mb-2">Gestión, Herramientas & QA</h3>
    <hr class="w-3/4 mx-auto border-blue-500/50 mb-2">
    <ul class="w-full grid grid-cols-2 lg:grid-cols-3 gap-3">
        {skills.map((skill) => <SkillChip {...skill} />)}
    </ul>
</article>