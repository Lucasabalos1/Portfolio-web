---
interface BrowserCardProps {
    title: string;
    url: string;
    image: string;
}

interface Props {
    projects?: BrowserCardProps[];
}

const defaultProjects: BrowserCardProps[] = [
    { title: "BodyFlow",    url: "https://body-flow-beta.vercel.app/",    image: "/Images/Projects/Bodyflow/Dashboard.png" },
    { title: "BookMyStyle", url: "https://boomystyle.vercel.app/",        image: "/Images/Projects/Bookmystyle/Dashboard.jpg" },
    { title: "ApptitudIA",  url: "https://disponibilizacionweb.onrender.com/", image: "/Images/Projects/ApptitudIA/Dashboard.jpg" },
];

const { projects = defaultProjects } = Astro.props;
---

<div class="relative w-full max-w-sm animate-float animate-infinite motion-reduce:animate-none" data-browser-stack>
    <div class="absolute -inset-6 rounded-full bg-blue-500/20 blur-3xl animate-pulse" aria-hidden="true"></div>

    <div class="relative w-full h-64 rotate-2" role="presentation">
        {
            projects.map((project) => (
                <div class="absolute inset-0 rounded-2xl border border-white/10 bg-[#0d1224] shadow-2xl shadow-blue-500/20 overflow-hidden transition-all duration-700" data-stack-card aria-hidden="true">
                    <div class="flex items-center gap-2 px-4 py-3 border-b border-white/10">
                        <span class="w-3 h-3 rounded-full bg-red-400/80"></span>
                        <span class="w-3 h-3 rounded-full bg-yellow-400/80"></span>
                        <span class="w-3 h-3 rounded-full bg-green-400/80"></span>
                        <span class="ml-3 flex-1 rounded-md bg-white/5 px-3 py-1 text-xs text-white/50 truncate">{project.url}</span>
                    </div>
                    <div class="h-[calc(100%-2.5rem)] overflow-hidden">
                        <img src={project.image} alt={`Dashboard de ${project.title}`} class="w-full h-full object-cover object-top" />
                    </div>
                </div>
            ))
        }
    </div>
</div>

<script>
    (function () {
        const browserStack = document.querySelector<HTMLElement>("[data-browser-stack]");
        const projectCards = browserStack ? Array.from(browserStack.querySelectorAll<HTMLElement>("[data-stack-card]")) : [];

        if (!browserStack || projectCards.length === 0) return;

        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        const updateStackPositions = (activeIndex: number) => {
            projectCards.forEach((cardElement, index) => {
                const relativePosition = (index - activeIndex + projectCards.length) % projectCards.length;
                if (relativePosition === 0) {
                    cardElement.style.transform = "scale(1) rotate(0)";
                    cardElement.style.opacity = "1";
                } else if (relativePosition === 1) {
                    cardElement.style.transform = "scale(0.92) rotate(-2deg)";
                    cardElement.style.opacity = "0.6";
                } else {
                    cardElement.style.transform = "scale(0.84) rotate(2deg)";
                    cardElement.style.opacity = "0.3";
                }
                cardElement.style.zIndex = String(30 - relativePosition);
            });
        };

        const showNextProject = () => {
            updateStackPositions((activeIndex = (activeIndex + 1) % projectCards.length));
        };

        let activeIndex = 0;
        updateStackPositions(activeIndex);

        if (reduceMotion) return;

        let cycleTimer = window.setInterval(showNextProject, 3500);

        browserStack.addEventListener("mouseenter", () => window.clearInterval(cycleTimer));
        browserStack.addEventListener("mouseleave", () => {
            cycleTimer = window.setInterval(showNextProject, 3500);
        });
    })();
</script>